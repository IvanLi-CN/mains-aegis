{
  "name": "mains-aegis",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitlint-plugin-function-rules": "^4.0.2"
  },
  "scripts": {
    "commitlint": "commitlint",
    "web:dev": "cd web && bun run dev",
    "web:preview": "cd web && bun run preview",
    "web:build": "cd web && bun run build",
    "web:check": "cd web && bun run check",
    "web:storybook": "cd web && bun run storybook",
    "web:storybook:build": "cd web && bun run storybook:build"
  }
}
