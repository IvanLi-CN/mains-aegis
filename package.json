{
  "name": "mains-aegis",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitlint-plugin-function-rules": "^4.0.2"
  },
  "scripts": {
    "commitlint": "commitlint",
    "firmware:embed-web": "python3 tools/firmware-artifact/embed-web-assets.py --catalog firmware/target/mains-aegis-artifacts/firmware-catalog.json --out web/public/firmware --clean",
    "web:dev": "cd web && bun run dev",
    "web:preview": "cd web && bun run preview",
    "web:build": "cd web && bun run build",
    "web:check": "cd web && bun run check",
    "web:test": "cd web && bun run test"
  }
}
